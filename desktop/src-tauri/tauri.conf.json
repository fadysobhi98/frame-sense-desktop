{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame Sense",
  "version": "0.6.5",
  "identifier": "com.framesense.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frame Sense",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "framesense_raw.dll",
      "onnxruntime.dll",
      "onnxruntime_providers_shared.dll",
      "models/face_mesh.onnx",
      "models/seeta_fd_frontal_v1.0.bin",
      "models/open_closed_eye.onnx"
    ]
  }
}